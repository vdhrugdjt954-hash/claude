# 花园那边签给这台机的 token
GARDEN_BASE_URL=https://wake-v1.abysslumina.com
GARDEN_MACHINE_TOKEN=replace-with-machine-token

# injector：用 node 跑这份脚本，路径按手机里实际放的位置改
GARDEN_INJECTOR_EXECUTABLE=/usr/bin/node
GARDEN_INJECTOR_ARGS_JSON='["/root/claude/garden-wake/inject-claude-routine.mjs"]'
GARDEN_LOG_LEVEL=info

# Routine「花园唤醒」的 API 触发器，在 claude.ai/code/routines 里生成
CLAUDE_ROUTINE_FIRE_URL=https://api.anthropic.com/v1/claude_code/routines/trig_01EaNaQstve8AQpLwYKoYTtX/fire
CLAUDE_ROUTINE_TOKEN=replace-with-routine-token
