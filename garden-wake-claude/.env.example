# 官方唤醒桥
GARDEN_BASE_URL=https://wake-v1.abysslumina.com
GARDEN_MACHINE_TOKEN=replace-with-machine-token
GARDEN_LOG_LEVEL=info

# tmux 注入器：打进哪个 pane（open-claude.sh 默认开的是 linfan:0.0）
CLAUDE_TMUX_TARGET=linfan:0.0
# pane 里跑的程序名，原生安装是 claude，npm 安装是 node
CLAUDE_TMUX_EXPECT_COMMAND=claude,node
# 碰上权限确认框会等它关掉，这里给两分钟
CLAUDE_INJECTOR_TIMEOUT_MS=120000

# 唤醒桥启动时如果 tmux 里没有 Claude 窗口，就自动开一个（1 开 / 0 不开）
OPEN_CLAUDE_ON_START=1
# 自动开窗口时的工作目录，默认是仓库根目录
# CLAUDE_WORKDIR=/Users/你的用户名/claude-repo
